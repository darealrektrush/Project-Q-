{
  "name": "project-q",
  "version": "1.0.0",
  "private": true,
  "description": "FawkQ Telegram bot + reward distribution service (Phase 1)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env.local src/server.js",
    "distribute": "node jobs/distribute.js",
    "post-signal": "node jobs/postSignal.js",
    "settle-campaign-xp": "node jobs/settleCampaignXp.js",
    "settle-community-activity": "node jobs/settleCommunityActivity.js",
    "rehearse:bond-provisioning": "node scripts/rehearse-bond-provisioning.js",
    "rehearse:bond-25": "node scripts/rehearse-bond-25-profiles.js",
    "rehearse:bond-automated": "node scripts/rehearse-bond-automated.js",
    "rehearse:bond-devnet": "node scripts/rehearse-bond-devnet.js",
    "check:bond-devnet-payer": "node scripts/check-bond-devnet-payer.js",
    "qualify:bond-launch": "node scripts/qualify-bond-launch.js",
    "rehearse:oracle-project-q": "node scripts/rehearse-oracle-project-q-canary.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test",
    "audit:bond-registry": "node scripts/audit-bond-registry.js",
    "audit:bond-sources": "node scripts/audit-bond-source-certifications.js",
    "audit:bond-rules": "node scripts/audit-bond-rules.js",
    "prepare:bond-draw": "node scripts/prepare-bond-draw-commitments.js",
    "audit:bond-cutoff": "node scripts/audit-bond-draw-cutoff.js",
    "audit:bond-funding": "node scripts/audit-bond-funding.js",
    "audit:bond-burn-provisioning": "node scripts/audit-bond-burn-provisioning.js",
    "provision:bond-burn": "node scripts/provision-bond-burn.js",
    "prepare:bond-final-rules": "node scripts/prepare-bond-final-rules.js",
    "schedule:bond-final-cycles": "node scripts/schedule-bond-final-cycles.js",
    "rehearse:bond-launch": "node scripts/rehearse-bond-launch.js",
    "submit:bond-funding-proposal": "node scripts/submit-bond-funding-proposal.js",
    "submit:bond-source-certifications": "node scripts/submit-bond-source-certifications.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    },
    "stream-json": "3.7.0"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.15",
    "@sqds/multisig": "2.1.4"
  }
}
