# --- Server ---
PORT=3000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Secret string set via setWebhook(secret_token=...); must match x-telegram-bot-api-secret-token header
TELEGRAM_WEBHOOK_SECRET=
# Bot's @username (no @), used to build t.me deep links (e.g. bwfeedback)
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram numeric user IDs allowed to use /adminf in the bot's private DM
TELEGRAM_ADMIN_USER_IDS=
# The forum supergroup's chat id (negative number, e.g. -1001234567890)
TELEGRAM_CHAT_ID=
# Allowlist of forum topics as name:message_thread_id pairs
TELEGRAM_TOPIC_IDS=fawkq-chat:111,fawkq-announcements:222,fawkq-bagwork:333

# --- fawkq.com website webhook ---
# This is BAGWORK_WEBHOOK_SECRET in PROJECTQ-WEBHOOK.md — same value, must
# match the Cloudflare Worker secret exactly. Andrew sends it; do not generate
# your own.
BAGWORK_SECRET=
FAWKQ_WEBSITE_URL=https://fawkq.com
FAWKQ_BAGWORK_URL=https://fawkq.com/bagwork
# XP awarded per 1 SOL of bagwork reward
XP_PER_SOL=1000

# --- X / Twitter auto-poster (optional, free marketing) ---
# When all four are set, each completed distribution auto-posts an on-chain
# "receipt" to X. Leave blank to disable — posting is best-effort and never
# blocks a distribution run. Get these from developer.x.com -> your Project ->
# "Keys and tokens". The access token/secret must belong to the account you
# want to post as, and the app needs Read AND Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana / Helius ---
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
TOKEN_MINT=

# --- Wallets ---
# Isolated hot wallet that receives creator rewards; signs Stage 1. Base58 secret key.
CREATOR_WALLET_SECRET=
CREATOR_WALLET_PUBLIC=
# Plain hot wallet (NOT a Squads multisig) that signs Stage 2 automatically. Base58 secret key.
COMMUNITY_WALLET_SECRET=
COMMUNITY_WALLET_PUBLIC=
# Never comingled with other funds
DEV_WALLET_PUBLIC=
# Can be a Squads multisig, only ever receives funds
OCEAN_WALLET_PUBLIC=
BAG_WALLET_PUBLIC=
# Parked for manual pump.fun buys, not automated
BUYBACK_RESERVE_WALLET_PUBLIC=
# Shown in /wallets' supply-holding section, alongside their token balance
ANDREW_COFOUNDER_WALLET_PUBLIC=
THOMAS_COFOUNDER_WALLET_PUBLIC=
# Underlying SPL token account for each founder's Streamflow-locked supply —
# not the Streamflow Lock contract ID itself, which is a separate metadata
# account with no token balance of its own. Shown in /wallets; either can be
# left unset if that founder has no lock set up yet.
ANDREW_COFOUNDER_STREAMFLOW_LOCK_ACCOUNT=
THOMAS_COFOUNDER_STREAMFLOW_LOCK_ACCOUNT=

# Lamports left in the creator wallet as a fee buffer, not distributed
DISTRIBUTION_RESERVE_LAMPORTS=5000000
# Lamports held back from the community wallet's Stage 2 redistribution, so
# it always keeps enough to pay its own future transaction fees
STAGE2_RESERVE_LAMPORTS=5000000
